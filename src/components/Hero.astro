---
import { company } from '../data/company';
---
<section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">{company.englishName}</p><h1 id="hero-title">{company.tagline}</h1><p class="hero-lead">{company.lead}</p><p class="hero-description">{company.heroDescription}</p><a class="button" href="#contact">{company.contactCta} <span aria-hidden="true">↗</span></a><p class="demo-label">WEB DESIGN PROPOSAL / ご提案用デモ</p></div><div class="hero-visual">{company.heroImage ? <img src={company.heroImage.src} alt={company.heroImage.alt} width="1200" height="900" fetchpriority="high" /> : <div class="photo-placeholder"><span aria-hidden="true" class="photo-grid"></span><span class="placeholder-copy"><strong>CONSTRUCTION PHOTO</strong><small>施工写真掲載予定 / 写真未設定</small></span></div>}</div><div class="hero-bottom"><span>WATERPROOFING</span><a href="#about">SCROLL DOWN ↓</a></div></section>
