---
import { company } from '../data/company';
---
<section class="section process" aria-labelledby="process-title"><p class="eyebrow">HOW WE WORK</p><h2 id="process-title">ご相談から、工事のその先まで。</h2><ol class="step-grid">{company.steps.map((step, i) => <li><span class="number">STEP 0{i + 1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></section>
