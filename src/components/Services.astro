---
import { company } from '../data/company';
---
<section id="services" class="section" aria-labelledby="services-title"><div class="section-heading"><div><p class="eyebrow">OUR SERVICES</p><h2 id="services-title">防水工事の専門技術</h2></div><p>取り扱う工事の種類をご紹介します。</p></div><div class="service-grid">{company.services.map((service, i) => <article class="service-card"><div class="card-top"><span class="number">0{i + 1}</span><span class="eyebrow">{service.label}</span></div><h3>{service.title}</h3><p>{service.description}</p></article>)}</div></section>
