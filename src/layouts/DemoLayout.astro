---
import { company } from '../data/company';
import '../styles/global.scss';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="description" content={company.description} /><meta name="theme-color" content="#102A43" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={company.description} /><meta property="og:locale" content="ja_JP" /><title>{title}</title></head><body id="top"><a class="skip-link" href="#main">本文へスキップ</a><slot /></body></html>
